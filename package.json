{
  "name": "global-sourcing-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:frontend": "vite --host 127.0.0.1",
    "dev:api": "tsx --env-file-if-exists=.env server/index.ts",
    "start": "tsx server/index.ts",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "admin": "tsx --env-file-if-exists=.env scripts/admin.ts",
    "typecheck:api": "tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test src/*.test.ts src/lib/*.test.ts server/*.test.ts",
    "test:db": "tsx --env-file-if-exists=.env --test --test-concurrency=1 server/db/*.test.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "lucide-react": "^0.468.0",
    "openid-client": "^6.8.8",
    "pg": "^8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0"
  }
}
