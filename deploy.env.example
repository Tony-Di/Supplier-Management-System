# Copy to deploy.env (not committed) and fill in. Used by compose.intranet.yml.

# Port on the host; the app is reached at http://<host>:<HOST_PORT>
HOST_PORT=8080

# The address people type into the browser, e.g. http://sourcing-srv:8080
APP_ORIGIN=

# openssl rand -hex 24 (hex keeps it safe inside the database URL)
POSTGRES_PASSWORD=

# openssl rand -hex 32
SESSION_SECRET=

# dev: everyone is signed in as one shared "Dev User" account, with no
# Microsoft sign-in. Intranet trial use only.
# password: each person signs in with their SEG email address and a password
# they set from an emailed link; works over plain http on the intranet. Needs
# SIGN_UP_EMAIL_DOMAINS and the SMTP_ values below.
# entra: each person signs in with their SEG account; needs the three ENTRA_
# values below and an HTTPS APP_ORIGIN registered as <APP_ORIGIN>/api/auth/callback.
AUTH_MODE=dev

# Set to production together with AUTH_MODE=entra, or with password behind
# HTTPS: secure cookies, HTTPS APP_ORIGIN required, and the dev sign-in refused.
# Keep development when the app is reached over plain http.
NODE_ENV=development

# on: a buyer may select a quote without a sample by confirming earlier orders
# (for suppliers with a Since date). Set to off once ERP purchase history is in
# the system.
PREVIOUS_ORDER_SELECTION=on

ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# AUTH_MODE=password: email domains that may create an account, comma-separated.
SIGN_UP_EMAIL_DOMAINS=segsolar.com,segsolar-ind.com

# AUTH_MODE=password: the mailbox that sends sign-up and password links.
# Office 365: smtp.office365.com, port 587, the mailbox address and its password
# (an app password if the account uses MFA). MAIL_FROM defaults to SMTP_USER.
# Without SMTP_HOST the links are only written to the app log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
