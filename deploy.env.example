# Copy to deploy.env (not committed) and fill in. Used by compose.intranet.yml.

# Port on the host; the app is reached at http://<host>:<HOST_PORT>
HOST_PORT=8080

# The address people type into the browser, e.g. http://sourcing-srv:8080
APP_ORIGIN=

# openssl rand -hex 24 (hex keeps it safe inside the database URL)
POSTGRES_PASSWORD=

# openssl rand -hex 32
SESSION_SECRET=

# dev: everyone is signed in as one shared "Dev User" account, with no
# Microsoft sign-in. Intranet trial use only.
# entra: each person signs in with their SEG account; needs the three ENTRA_
# values below and an HTTPS APP_ORIGIN registered as <APP_ORIGIN>/api/auth/callback.
AUTH_MODE=dev

# Set to production together with AUTH_MODE=entra: secure cookies, HTTPS
# APP_ORIGIN required, and the dev sign-in refused.
NODE_ENV=development

ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
