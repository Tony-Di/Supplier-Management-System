# Database — docker compose -f compose.dev.yml up -d
DATABASE_URL=postgres://sourcing:sourcing@127.0.0.1:5433/sourcing
# A second database used only by npm run test:db
DATABASE_URL_TEST=postgres://sourcing:sourcing@127.0.0.1:5433/sourcing_test

# At least 32 random characters: openssl rand -hex 32
SESSION_SECRET=

# Where the browser reaches this app; must match the Entra redirect URI
APP_ORIGIN=http://127.0.0.1:5173
API_PORT=5174

# entra (default), password or dev.
#   entra:    Microsoft sign-in; needs the ENTRA_ values below and an https APP_ORIGIN.
#   password: SEG email address and a password set from an emailed link; needs
#             SIGN_UP_EMAIL_DOMAINS, and SMTP_HOST in production.
#   dev:      signs in a fixed local account; refused in production.
AUTH_MODE=dev

# on (default) or off. While on, a buyer may select a quote without a sample by
# confirming earlier orders. Switch it off once ERP purchase history is in the system.
PREVIOUS_ORDER_SELECTION=on

# Entra app registration — redirect URI is <APP_ORIGIN>/api/auth/callback
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# AUTH_MODE=password: email domains that may create an account, comma-separated
SIGN_UP_EMAIL_DOMAINS=segsolar.com,segsolar-ind.com

# Mail server for sign-up and password links. Leave SMTP_HOST empty to write the
# emails to the API log instead (development only). Office 365: smtp.office365.com,
# port 587, and the mailbox's address and password; MAIL_FROM defaults to SMTP_USER.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
